matplotlib e seaborn:

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import mysql.connector

# Conectar ao banco de dados MySQL
conn = mysql.connector.connect(
    host="seu_host",
    user="seu_usuario",
    password="sua_senha",
    database="seu_banco"
)

# Ler dados da view ranking_co2_numerico
query = "SELECT pais, modelo, co2_total, ranking FROM ranking_co2_numerico WHERE ranking <= 3"
df = pd.read_sql(query, conn)

# Fechar conexão
conn.close()

# Configurar estilo
sns.set(style="whitegrid")
plt.figure(figsize=(12,6))

# Gráfico de barras lado a lado por país
ax = sns.barplot(data=df, x='modelo', y='co2_total', hue='pais')

# Adicionar ranking sobre cada barra
for i, row in df.iterrows():
    ax.text(i, row['co2_total'] + 0.5, f"{int(row['ranking'])}º", ha='center', va='bottom', fontweight='bold')

plt.xlabel('Modelo da Bicicleta')
plt.ylabel('CO₂ Evitado (kg)')
plt.title('Top 3 Modelos Mais Verdes por País com Ranking')
plt.xticks(rotation=45)
plt.legend(title='País')
plt.tight_layout()
plt.show()
